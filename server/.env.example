NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/qiststore
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
LOG_LEVEL=info

# ---- Image / file storage (Cloudinary) -------------------------------------
# Dashboard → Account Details → API Keys. Until these are set, the admin upload
# endpoints answer 503 CLOUDINARY_NOT_CONFIGURED (the rest of the app works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=qiststore/products
